# Backend environment variables for local development
# Copy this file to backend/.env and fill in your own values.

PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lvf8gvr.mongodb.net/chat_db?retryWrites=true&w=majority

# JWT secret used to sign authentication tokens
JWT_SECRET=your_jwt_secret_here

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
